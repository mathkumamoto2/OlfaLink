# Demo data only; never treat the demo data as live or validated.
APP_MODE=demo
DEVICE_ID=olfalink-01
# For real device ingest supply a high-entropy secret via Secret Manager.
# DEVICE_INGEST_KEY=
# For persistent cloud history, set APP_MODE=firestore and enable Firestore.
FIRESTORE_COLLECTION=olfalink_readings
AI_PROVIDER=disabled
LLM_PROVIDER=disabled
