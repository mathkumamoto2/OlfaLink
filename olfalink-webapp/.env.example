# AWS named-session archive: real HTTP requests from the Cloud Run server.
APP_MODE=aws
# NEVER commit the AWS key, use Secret Manager on Cloud Run.
# OLFALINK_READ_KEY=
AI_PROVIDER=disabled
LLM_PROVIDER=disabled
# Optional private LoRA narration service, requires GPU deployment and IAM invoker.
# LLM_SERVICE_URL=https://<your-private-service-url>
