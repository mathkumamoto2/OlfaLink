# For Cloud Run, configure via deploy_on_demand.sh and Secret Manager.
APP_MODE=on_demand
LIVE_DEVICE_ID=esp1
# LIVE_INGEST_KEY= [only from Secret Manager, NEVER commit actual key]
# OLFALINK_READ_KEY= [historical AWS diagnostics only]
AI_PROVIDER=disabled
LLM_PROVIDER=disabled
